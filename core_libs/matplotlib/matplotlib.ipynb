   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# data\n",
    "x = np.array([1, 2, 3, 4, 5])\n",
    "y = np.array([15, 27, 30, 32, 45])\n",
    "\n",
    "# create line plot\n",
    "plt.plot(x, y, marker=\"o\")\n",
    "plt.title(\"Line Plot\")\n",
    "plt.xlabel('X Axis')\n",
    "plt.ylabel('Y Axis')\n",
    "plt.show()"
   ]
  }
